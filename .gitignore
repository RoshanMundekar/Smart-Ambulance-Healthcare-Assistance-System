# ============================================================
# Smart Ambulance & Healthcare Assistance System — .gitignore
# ============================================================

# ---- SECRETS — NEVER COMMIT --------------------------------
.env
*.pem
*.key
*.p12
secrets/

# ---- Python ---------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ---- Virtual Environments ------------------------------------
venv/
.venv/
env/
ENV/

# ---- Logs ----------------------------------------------------
logs/
*.log

# ---- AI Models (large binaries) ------------------------------
backend/app/ai/models/*.pkl
backend/app/ai/models/*.joblib
backend/app/ai/models/*.h5
backend/app/ai/models/*.pt
backend/app/ai/models/*.bin
backend/ai_training/__pycache__/

# ---- Database ------------------------------------------------
*.db
*.sqlite3

# ---- Node / Frontend (if added later) -----------------------
node_modules/
.npm

# ---- Docker volumes ------------------------------------------
mysql_data/

# ---- IDE & OS ------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
