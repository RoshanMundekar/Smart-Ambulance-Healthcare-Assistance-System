# ============================================================
# SMART AMBULANCE & HEALTHCARE ASSISTANCE SYSTEM
# Environment Variables — TEMPLATE
# ============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your actual values below
# 3. NEVER commit .env to version control

# Application Settings
APP_NAME="Smart Ambulance & Healthcare System"
APP_VERSION="1.0.0"
DEBUG=True
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-random-32-char-secret-key

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_ambulance_db
DB_USER=root
DB_PASSWORD=your-db-password-here
DATABASE_URL=mysql+pymysql://root:your-db-password-here@localhost:3306/smart_ambulance_db

# JWT Settings
JWT_SECRET_KEY=change-this-to-a-random-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Maps API
# Get your key at: https://console.cloud.google.com/apis/credentials
# Enable: Maps JavaScript API, Directions API, Geocoding API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com/maps/api/js?key=your-google-maps-api-key-here&libraries=places

# WebSocket
WS_HOST=localhost
WS_PORT=8001

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500

# AI Model Paths
AI_MODEL_DIR=./app/ai/models
SPACY_MODEL=en_core_web_sm

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Notification Settings (optional — leave blank to disable)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Email Settings (optional — leave blank to disable)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-app-password
